<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network is used only for the optional cloud sync (Supabase sign-in and storage), and only for
         already-encrypted files: app/Net.java refuses everything except HTTPS to the one configured
         Supabase host. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:name=".SilkApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Silk">

        <!-- Lets Google Play services fetch the QR scanner when the app is installed from Google Play;
             from anywhere else it is fetched the first time the scanner opens. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|navigation|layoutDirection|locale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="silk" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Unlock prompt shown by the autofill dropdown. It runs in its own process so its Rust runtime
             can't collide with the main app's. -->
        <activity
            android:name=".AuthActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|navigation|layoutDirection|locale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":auth"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="silk" />
        </activity>

        <service
            android:name=".AutofillSvc"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
