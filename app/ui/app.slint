// Silk UI. A soft grey, off-white palette: one neutral family, dark grey for primary actions and
// no accent hues. Every color lives in `Theme` below and components only refer to it (the one
// exception is the black tint of the two drop shadows).
// Motion: screens cross-fade and rise into place, the tab bar slides, controls respond to
// touch, banners expand, and the countdown bars glide.

export struct Row { id: string, title: string, subtitle: string }
export struct OtpRow { id: string, title: string, subtitle: string, code: string, left-text: string, progress: float }

// Light is the specified palette. Dark (follows the system setting) is the same neutral family inverted.
export global Theme {
    in property <bool> dark: false;
    // Backgrounds: page, secondary fill (quiet buttons, disabled), white cards, a step above the page.
    in-out property <color> bg: dark ? #1a1a19 : #f5f5f4;
    in-out property <color> surface: dark ? #222221 : #eeeeec;
    in-out property <color> card: dark ? #1f1f1e : #ffffff;
    in-out property <color> elevated: dark ? #262625 : #fafaf9;
    // Pressed and hover washes for rows and quiet controls.
    in-out property <color> raised: dark ? #353534 : #dcdcdc;
    in-out property <color> hover: dark ? #2e2e2d : #e5e5e5;
    // Text: primary, secondary, muted (hints, disabled).
    in-out property <color> fg: dark ? #e5e5e4 : #262626;
    in-out property <color> muted: dark ? #a3a3a3 : #737373;
    in-out property <color> faint: dark ? #737373 : #a3a3a3;
    // Primary action: dark grey with white text (inverted in dark). Soft fill = the secondary button.
    in-out property <color> accent: dark ? #e5e5e4 : #303030;
    in-out property <color> on-accent: dark ? #1a1a19 : #ffffff;
    in-out property <color> accent-soft: dark ? #2c2c2b : #eaeaea;
    // The only hue left is a muted red, for errors and the low-time warning.
    in-out property <color> danger: dark ? #e58a82 : #a63d36;
    in-out property <color> danger-soft: dark ? #3a2523 : #f2e3e1;
    // Borders: primary, secondary (under the tab bar), divider (inside a card), focus; the toggle/slider track.
    in-out property <color> outline: dark ? #3a3a39 : #e5e5e5;
    in-out property <color> outline-soft: dark ? #333332 : #ebebeb;
    in-out property <color> divider: dark ? #2a2a29 : #f0f0f0;
    in-out property <color> focus-border: dark ? #737373 : #a3a3a3;
    in-out property <color> track: dark ? #454544 : #d4d4d4;
    in-out property <color> scrim: dark ? #000000b8 : #2626268f;
    // One corner radius for controls (buttons, fields, chips) and one for cards and dialogs.
    out property <length> r-control: 10px;
    out property <length> r-card: 14px;
}

// Line icons drawn as vector paths (no image files).
// 0 key, 1 clock, 2 sliders, 3 menu, 4 plus, 5 search, 6 shield, 7 chevron, 8 minus
component SilkIcon inherits Rectangle {
    in property <int> kind: 0;
    in-out property <color> tint: Theme.fg;
    in property <length> thickness: 2px;
    width: 24px;
    height: 24px;
    animate tint { duration: 200ms; easing: ease-out; }
    if root.kind == 0 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 15 A4 4 0 1 1 4 15 A4 4 0 1 1 12 15 Z M10.8 12.2 L20 3 M17 6 L20 9 M14 9 L16.5 11.5";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 1 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3 A9 9 0 1 1 12 21 A9 9 0 1 1 12 3 Z M12 7 L12 12 L15.5 14";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 2 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M4 7 L14 7 M18 7 L20 7 M4 17 L6 17 M10 17 L20 17 M16 4 L16 10 M8 14 L8 20";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 3 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M4 7 L20 7 M4 12 L20 12 M4 17 L14 17";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 4 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 5 L12 19 M5 12 L19 12";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 5 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M11 4 A7 7 0 1 1 11 18 A7 7 0 1 1 11 4 Z M16.5 16.5 L21 21";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 6 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3 L19 6 L19 12 C19 16.5 16 19.8 12 21 C8 19.8 5 16.5 5 12 L5 6 Z M9 12 L11 14 L15 10";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 7 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M9 6 L15 12 L9 18";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.kind == 8 : Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M5 12 L19 12";
        stroke: root.tint;
        stroke-width: root.thickness;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// Three bouncing dots. Only animates while it is on screen.
component SilkDots inherits Rectangle {
    in property <color> tint: Theme.on-accent;
    width: 44px;
    height: 14px;
    for i in 3 : Rectangle {
        property <float> phase: Math.sin((animation-tick() / 1s * 5.0 - i * 0.9) * 1rad);
        x: i * 18px;
        y: 4px - 4px * max(0.0, self.phase);
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.tint;
        opacity: 0.5 + 0.5 * max(0.0, self.phase);
    }
}

// One screen of the app: fades and rises in when active, fades out when not.
component SilkScreen inherits Rectangle {
    in property <bool> active: false;
    opacity: root.active ? 1.0 : 0.0;
    y: root.active ? 0px : 14px;
    visible: root.opacity > 0.01;
    animate opacity { duration: root.active ? 260ms : 110ms; easing: ease-out; }
    animate y { duration: root.active ? 320ms : 110ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    @children
}

// Error (preferred) or notice message that expands in and collapses away.
component SilkBanner inherits Rectangle {
    in property <string> error: "";
    in property <string> notice: "";
    property <string> msg: root.error != "" ? root.error : root.notice;
    property <bool> open: root.msg != "";
    out property <length> wanted: root.open ? txt.preferred-height + 24px : 0px;
    property <string> kept: "";
    property <bool> kept-error: false;
    changed msg => {
        if (root.msg != "") {
            root.kept = root.msg;
            root.kept-error = root.error != "";
        }
    }
    height: root.wanted;
    clip: true;
    border-radius: Theme.r-control;
    background: root.kept-error ? Theme.danger-soft : Theme.accent-soft;
    opacity: root.open ? 1.0 : 0.0;
    animate height { duration: 240ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    animate opacity { duration: 200ms; easing: ease-out; }
    txt := Text {
        x: 16px;
        y: 12px;
        width: parent.width - 32px;
        text: root.kept;
        wrap: word-wrap;
        font-size: 14px;
        color: root.kept-error ? Theme.danger : Theme.accent;
    }
}

component SilkButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> active: true;
    in property <bool> busy: false;
    callback clicked();
    height: 54px;
    border-radius: Theme.r-control;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.outline;
    // Primary: dark grey. Secondary: light grey. Disabled: a flat, quiet grey with a faint label.
    background: root.busy ? Theme.accent : !root.active ? Theme.surface : root.primary ? Theme.accent : Theme.accent-soft;
    animate background { duration: 160ms; easing: ease-out; }
    // Hover and pressed are a light wash of the label color over the fill.
    Rectangle {
        border-radius: root.border-radius;
        background: root.primary ? Theme.on-accent : Theme.accent;
        opacity: !root.active ? 0.0 : touch.pressed ? 0.16 : touch.has-hover ? 0.07 : 0.0;
        animate opacity { duration: touch.pressed ? 60ms : 240ms; easing: ease-out; }
    }
    touch := TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
    }
    Text {
        x: 0px;
        y: touch.pressed ? 1px : 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: !root.active ? Theme.faint : root.primary ? Theme.on-accent : Theme.accent;
        font-size: 16px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: root.busy ? 0.0 : 1.0;
        animate y { duration: 90ms; easing: ease-out; }
        animate opacity { duration: 140ms; }
    }
    if root.busy : SilkDots {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: Theme.on-accent;
    }
}

component SilkLink inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    callback clicked();
    height: 44px;
    border-radius: Theme.r-control;
    preferred-width: label.preferred-width + 16px;
    min-width: label.preferred-width + 16px;
    background: touch.pressed ? Theme.raised : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 140ms; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        label := Text {
            text: root.text;
            color: root.tint;
            font-size: 15px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

// A small rounded action with an optional icon.
component SilkPill inherits Rectangle {
    in property <string> text;
    in property <int> icon: -1;
    callback clicked();
    property <length> w: root.icon >= 0 ? 68px : 60px;
    property <length> icon-w: root.icon >= 0 ? 20px : 0px;
    property <length> gap: root.icon >= 0 ? 2px : 0px;
    // Centers icon + label in the fixed width; the 2px shift offsets the icon's own empty margin.
    property <length> start: (root.w - root.icon-w - root.gap - lbl.preferred-width) / 2 - (root.icon >= 0 ? 2px : 0px);
    height: 40px;
    border-radius: Theme.r-control;
    preferred-width: root.w;
    min-width: root.w;
    max-width: root.w;
    background: touch.pressed ? Theme.raised : touch.has-hover ? Theme.hover : Theme.accent-soft;
    animate background { duration: 140ms; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    if root.icon >= 0 : SilkIcon {
        x: root.start;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        kind: root.icon;
        tint: Theme.accent;
    }
    lbl := Text {
        x: root.start + root.icon-w + root.gap;
        y: 0px;
        height: parent.height;
        text: root.text;
        font-size: 15px;
        font-weight: 500;
        color: Theme.accent;
        vertical-alignment: center;
    }
}

component SilkIconButton inherits Rectangle {
    in property <int> icon: 4;
    in property <color> tint: Theme.accent;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: touch.pressed ? Theme.raised : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 140ms; easing: ease-out; }
    SilkIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        kind: root.icon;
        tint: root.tint;
        thickness: 2.4px;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SilkField inherits Rectangle {
    in property <string> label;
    in property <bool> secret: false;
    in property <bool> multiline: false;
    in property <int> icon: -1;
    in-out property <string> text <=> ti.text;
    callback edited();
    property <bool> lifted: ti.has-focus || ti.text != "";
    property <length> pad: root.icon >= 0 ? 46px : 14px;
    height: root.multiline ? 124px : 58px;
    border-radius: Theme.r-control;
    border-width: ti.has-focus ? 2px : 1px;
    border-color: ti.has-focus ? Theme.focus-border : Theme.outline;
    background: ti.has-focus ? Theme.card : Theme.elevated;
    animate border-color { duration: 180ms; easing: ease-out; }
    animate border-width { duration: 120ms; easing: ease-out; }
    animate background { duration: 180ms; easing: ease-out; }
    TouchArea { clicked => { ti.focus(); } }
    if root.icon >= 0 : SilkIcon {
        x: 14px;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        kind: root.icon;
        tint: ti.has-focus ? Theme.accent : Theme.muted;
    }
    Text {
        x: root.pad;
        y: root.lifted ? 8px : 19px;
        width: parent.width - root.pad - 14px;
        text: root.label;
        font-size: root.lifted ? 12px : 16px;
        color: ti.has-focus ? Theme.accent : Theme.muted;
        overflow: elide;
        animate y { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate font-size { duration: 180ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        animate color { duration: 180ms; }
    }
    ti := TextInput {
        x: root.pad;
        y: 27px;
        width: parent.width - root.pad - 14px;
        height: parent.height - 31px;
        font-size: root.secret ? 8px : 16px;
        color: Theme.fg;
        single-line: !root.multiline;
        wrap: root.multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
        input-type: root.secret ? InputType.password : InputType.text;
        edited => { root.edited(); }
    }
}

// The one loud element: a big live code with a countdown bar. Tap to copy.
component OtpCard inherits Rectangle {
    in property <string> code;
    in property <string> left-text;
    in property <float> progress;
    in property <bool> copyable: true;
    callback copy();
    property <bool> flashed: false;
    property <bool> low: root.progress < 0.18;
    property <float> pulse: 0.65 + 0.35 * Math.abs(Math.sin(animation-tick() / 1s * 3.1416 * 1rad));
    height: 132px;
    border-radius: Theme.r-card;
    background: Theme.accent-soft;
    Timer {
        interval: 1300ms;
        running: root.flashed;
        triggered => { root.flashed = false; }
    }
    touch := TouchArea {
        enabled: root.copyable;
        clicked => {
            root.flashed = true;
            root.copy();
        }
    }
    Text {
        x: 18px;
        y: 16px;
        text: root.code;
        font-size: 40px;
        font-weight: 600;
        color: root.low ? Theme.danger : Theme.accent;
        font-family: "monospace";
        opacity: root.low ? root.pulse : 1.0;
        animate color { duration: 300ms; }
    }
    Text {
        x: parent.width - 78px;
        y: 28px;
        width: 60px;
        text: root.left-text;
        font-size: 20px;
        font-weight: 600;
        color: root.low ? Theme.danger : Theme.fg;
        horizontal-alignment: right;
        animate color { duration: 300ms; }
    }
    Rectangle {
        x: 18px;
        y: 86px;
        width: parent.width - 36px;
        height: 8px;
        border-radius: 4px;
        background: Theme.card;
        Rectangle {
            width: parent.width * root.progress;
            height: parent.height;
            border-radius: 4px;
            background: root.low ? Theme.danger : Theme.accent;
            animate width { duration: 1000ms; easing: linear; }
            animate background { duration: 300ms; }
        }
    }
    Text {
        x: 18px;
        y: 106px;
        text: !root.copyable ? "Live preview" : root.flashed ? "Copied to clipboard" : "Tap to copy";
        font-size: 13px;
        font-weight: root.flashed ? 600 : 400;
        color: root.flashed ? Theme.accent : Theme.muted;
        animate color { duration: 200ms; }
    }
}

// An on/off switch with a label and an optional hint line.
component SilkToggle inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in-out property <bool> checked: false;
    callback toggled();
    height: root.hint == "" ? 56px : 68px;
    border-radius: Theme.r-control;
    background: touch.pressed ? Theme.surface : transparent;
    animate background { duration: 140ms; easing: ease-out; }
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.label; font-size: 16px; color: Theme.fg; overflow: elide; }
            if root.hint != "" : Text { text: root.hint; font-size: 12px; color: Theme.muted; overflow: elide; }
        }
        Rectangle {
            width: 54px;
            Rectangle {
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                width: 50px;
                height: 30px;
                border-radius: 15px;
                background: root.checked ? Theme.accent : Theme.track;
                animate background { duration: 220ms; easing: ease-out; }
                Rectangle {
                    property <length> d: touch.pressed ? 26px : (root.checked ? 22px : 18px);
                    animate d { duration: 160ms; easing: ease-out; }
                    width: self.d;
                    height: self.d;
                    border-radius: self.d / 2;
                    x: root.checked ? parent.width - self.d - 4px : 4px;
                    y: (parent.height - self.d) / 2;
                    background: root.checked ? Theme.on-accent : Theme.muted;
                    animate x { duration: 260ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
                    animate background { duration: 220ms; }
                }
            }
        }
    }
}

// A horizontal slider over a whole-number range. Tap or drag.
component SilkSlider inherits Rectangle {
    in property <int> minimum: 8;
    in property <int> maximum: 64;
    in-out property <int> value: 20;
    callback changed();
    height: 48px;
    property <float> ratio: (root.value - root.minimum) / (root.maximum - root.minimum);
    function pick(x: length) {
        root.value = min(root.maximum, max(root.minimum, root.minimum + Math.round((x - 14px) / (root.width - 28px) * (root.maximum - root.minimum))));
        root.changed();
    }
    Rectangle {
        x: 14px;
        y: (parent.height - 6px) / 2;
        width: parent.width - 28px;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
    }
    Rectangle {
        x: 14px;
        y: (parent.height - 6px) / 2;
        width: (parent.width - 28px) * root.ratio;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
        animate width { duration: touch.pressed ? 0ms : 160ms; easing: ease-out; }
    }
    Rectangle {
        property <length> d: touch.pressed ? 46px : 24px;
        animate d { duration: 160ms; easing: ease-out; }
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        x: 14px + (parent.width - 28px) * root.ratio - self.d / 2;
        y: (parent.height - self.d) / 2;
        background: Theme.accent;
        opacity: touch.pressed ? 0.2 : 0.0;
        animate opacity { duration: 160ms; }
        animate x { duration: touch.pressed ? 0ms : 160ms; easing: ease-out; }
    }
    Rectangle {
        property <length> d: touch.pressed ? 28px : 24px;
        animate d { duration: 120ms; easing: ease-out; }
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        x: 14px + (parent.width - 28px) * root.ratio - self.d / 2;
        y: (parent.height - self.d) / 2;
        background: Theme.accent;
        animate x { duration: touch.pressed ? 0ms : 160ms; easing: ease-out; }
    }
    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pick(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.pick(self.mouse-x);
            }
        }
    }
}

// One authenticator in the Codes list: live code, countdown bar. Tap to copy, "Edit" opens the login.
component CodeRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> code;
    in property <string> left-text;
    in property <float> progress;
    callback copy();
    callback edit();
    property <bool> flashed: false;
    property <bool> low: root.progress < 0.18;
    property <float> pulse: 0.65 + 0.35 * Math.abs(Math.sin(animation-tick() / 1s * 3.1416 * 1rad));
    height: 132px;
    Timer {
        interval: 1300ms;
        running: root.flashed;
        triggered => { root.flashed = false; }
    }
    Rectangle {
        x: 14px;
        y: 6px;
        width: parent.width - 28px;
        height: parent.height - 12px;
        border-radius: Theme.r-card;
        background: copy-touch.pressed ? Theme.surface : Theme.card;
        border-width: 1px;
        border-color: Theme.outline;
        animate background { duration: 140ms; easing: ease-out; }
        copy-touch := TouchArea {
            clicked => {
                root.flashed = true;
                root.copy();
            }
        }
        Text {
            x: 18px;
            y: 12px;
            width: parent.width - 110px;
            text: root.title;
            font-size: 17px;
            font-weight: 600;
            color: Theme.fg;
            overflow: elide;
        }
        Text {
            x: 18px;
            y: 35px;
            width: parent.width - 110px;
            text: root.subtitle;
            font-size: 13px;
            color: Theme.muted;
            overflow: elide;
        }
        Text {
            x: 18px;
            y: 54px;
            text: root.code;
            font-size: 34px;
            font-weight: 600;
            font-family: "monospace";
            color: root.low ? Theme.danger : Theme.accent;
            opacity: root.low ? root.pulse : 1.0;
            animate color { duration: 300ms; }
        }
        Text {
            x: parent.width - 98px;
            y: 66px;
            width: 80px;
            text: root.flashed ? "Copied" : root.left-text;
            font-size: 17px;
            font-weight: root.flashed ? 600 : 400;
            color: root.flashed ? Theme.accent : root.low ? Theme.danger : Theme.fg;
            horizontal-alignment: right;
            animate color { duration: 200ms; }
        }
        Rectangle {
            x: 18px;
            y: parent.height - 16px;
            width: parent.width - 36px;
            height: 6px;
            border-radius: 3px;
            background: Theme.surface;
            Rectangle {
                width: parent.width * root.progress;
                height: parent.height;
                border-radius: 3px;
                background: root.low ? Theme.danger : Theme.accent;
                animate width { duration: 1000ms; easing: linear; }
                animate background { duration: 300ms; }
            }
        }
        Rectangle {
            x: parent.width - 76px;
            y: 10px;
            width: 60px;
            height: 30px;
            border-radius: Theme.r-control;
            background: edit-touch.pressed ? Theme.raised : Theme.accent-soft;
            animate background { duration: 140ms; }
            Text {
                width: parent.width;
                height: parent.height;
                text: "Edit";
                font-size: 14px;
                font-weight: 500;
                color: Theme.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        edit-touch := TouchArea {
            x: parent.width - 96px;
            y: 0px;
            width: 96px;
            height: 52px;
            clicked => { root.edit(); }
        }
    }
}

// The bottom navigation. `current` is 0 to 3. Slides away when `shown` is false.
component TabBar inherits Rectangle {
    in property <int> current: 0;
    in property <bool> shown: true;
    in property <length> bottom-inset: 0px;
    callback pick(int);
    height: root.shown ? 68px + root.bottom-inset : 0px;
    animate height { duration: 280ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    clip: true;
    background: Theme.card;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.outline-soft;
    }
    Rectangle {
        x: root.current * (root.width / 4) + (root.width / 4 - 60px) / 2;
        y: 8px;
        width: 60px;
        height: 32px;
        border-radius: Theme.r-control;
        background: Theme.accent-soft;
        animate x { duration: 320ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
    }
    for label[i] in ["Logins", "Codes", "Generator", "More"] : Rectangle {
        x: i * (root.width / 4);
        y: 0px;
        width: root.width / 4;
        height: 68px;
        SilkIcon {
            x: (parent.width - 24px) / 2;
            y: i == root.current ? 12px : 14px;
            kind: i;
            tint: i == root.current ? Theme.accent : Theme.muted;
            animate y { duration: 260ms; easing: cubic-bezier(0.34, 1.5, 0.64, 1); }
        }
        Text {
            x: 0px;
            y: 44px;
            width: parent.width;
            text: label;
            font-size: 12px;
            font-weight: i == root.current ? 600 : 500;
            color: i == root.current ? Theme.accent : Theme.muted;
            horizontal-alignment: center;
            animate color { duration: 200ms; }
        }
        TouchArea { clicked => { root.pick(i); } }
    }
}

component SectionLabel inherits Text {
    font-size: 12px;
    font-weight: 500;
    color: Theme.muted;
}

component RowItem inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    callback clicked();
    height: 76px;
    Rectangle {
        x: 14px;
        y: 4px;
        width: parent.width - 28px;
        height: parent.height - 8px;
        border-radius: Theme.r-card;
        background: touch.pressed ? Theme.surface : touch.has-hover ? Theme.elevated : Theme.card;
        border-width: 1px;
        border-color: Theme.outline;
        animate background { duration: 140ms; easing: ease-out; }
        touch := TouchArea { clicked => { root.clicked(); } }
        Rectangle {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 44px;
            height: 44px;
            border-radius: Theme.r-control;
            background: Theme.accent-soft;
            SilkIcon {
                x: 10px;
                y: 10px;
                kind: 0;
                tint: Theme.accent;
            }
        }
        VerticalLayout {
            x: 68px;
            y: 0px;
            width: parent.width - 68px - 40px;
            height: parent.height;
            alignment: center;
            spacing: 2px;
            Text { text: root.title; font-size: 17px; font-weight: 600; color: Theme.fg; overflow: elide; }
            if root.subtitle != "" : Text { text: root.subtitle; font-size: 14px; color: Theme.muted; overflow: elide; }
        }
        SilkIcon {
            x: parent.width - 34px;
            y: (parent.height - self.height) / 2;
            kind: 7;
            tint: Theme.muted;
        }
    }
}

component SilkEmpty inherits Rectangle {
    in property <int> icon: 0;
    in property <string> title;
    in property <string> text;
    VerticalLayout {
        alignment: center;
        padding: 28px;
        spacing: 12px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 84px;
                border-radius: Theme.r-card;
                background: Theme.accent-soft;
                SilkIcon {
                    x: 22px;
                    y: 22px;
                    width: 40px;
                    height: 40px;
                    kind: root.icon;
                    tint: Theme.accent;
                    thickness: 2.2px;
                }
            }
        }
        Text { text: root.title; font-size: 18px; font-weight: 600; color: Theme.fg; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: root.text; font-size: 14px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
    }
}

export component MainWindow inherits Window {
    in-out property <bool> bio-available;
    in-out property <bool> bio-enrolled;
    callback bio-unlock();
    callback bio-set(bool);
    title: "Silk";
    background: Theme.bg;

    // 0 unlock or create, 1 logins, 2 edit login, 3 codes, 4 generator, 5 more, 6 add authenticator, 7 cloud account
    in-out property <int> screen: 0;
    in property <bool> creating: false;
    in property <bool> busy: false;
    in property <bool> autofill-on: true;
    in property <string> app-version: "";
    in property <bool> is-new: true;
    in property <string> error: "";
    in property <string> notice: "";
    in property <string> key-file-name: "";
    in property <[Row]> rows: [];
    in property <[OtpRow]> otp-rows: [];
    in property <string> otp-code: "";
    in property <string> otp-left-text: "";
    in property <float> otp-progress: 0.0;
    in property <bool> otp-invalid: false;
    in-out property <bool> show-password: false;
    in-out property <string> pw1: "";
    in-out property <string> pw2: "";
    in-out property <string> query: "";
    in-out property <string> f-title: "";
    in-out property <string> f-user: "";
    in-out property <string> f-password: "";
    in-out property <string> f-url: "";
    in-out property <string> f-otp: "";
    in-out property <string> f-notes: "";

    // Add authenticator
    in-out property <string> a-name: "";
    in-out property <string> a-secret: "";
    in property <string> a-code: "";
    in property <string> a-left-text: "";
    in property <float> a-progress: 0.0;
    in property <bool> a-invalid: false;

    // Generator settings (saved by the app)
    in-out property <int> gen-length: 20;
    in-out property <bool> gen-lower: true;
    in-out property <bool> gen-upper: true;
    in-out property <bool> gen-digits: true;
    in-out property <bool> gen-symbols: true;
    in-out property <bool> gen-lookalikes: true;
    in-out property <bool> auto-generate: true;
    in property <string> gen-preview: "";
    in property <string> gen-strength: "";

    // 0 nothing, 1 CSV, 2 JSON: which plain-text export is waiting for the "Export anyway" tap
    in-out property <int> export-ask: 0;

    // Cloud sync (Supabase sign-in and storage). The app sets the state; the account fields are typed on screen 7.
    in property <bool> cloud-configured: false;
    // Signed in, or a sign-in is saved in the key file: shows Sync now and Sign out.
    in property <bool> cloud-linked: false;
    in property <bool> cloud-busy: false;
    // This device and the cloud account hold different vaults: ask which one to keep.
    in property <bool> cloud-choice: false;
    in property <string> cloud-status: "";
    in-out property <string> cloud-email: "";
    in-out property <string> cloud-pw: "";
    callback cloud-sign-in();
    callback cloud-sign-up();
    callback cloud-sign-out();
    callback cloud-sync();
    // true: keep this device's vault (replaces the cloud one); false: use the cloud vault (replaces this one).
    callback cloud-choose(bool);

    callback submit();
    callback pick-key-file();
    callback create-key-file();
    callback clear-key-file();
    callback restore-backup();
    callback lock();
    callback backup();
    callback enable-autofill();
    callback search();
    callback new-login();
    callback open-login(string);
    callback save();
    callback delete-login();
    callback back();
    callback generate();
    property <bool> confirm-gen: false;
    // Screens stay loaded and fade out, so hand keyboard focus to a hidden item on every change.
    changed screen => {
        root.confirm-gen = false;
        focus-sink.focus();
    }
    callback copy-password();
    callback copy-otp();
    callback otp-edited();
    callback activity();
    callback go(int);
    callback copy-code(string);
    callback new-authenticator();
    callback auth-edited();
    callback save-authenticator();
    callback back-codes();
    callback gen-changed();
    callback gen-regenerate();
    callback gen-copy();
    callback import-proton();
    callback export-file(int);

    property <bool> show-tabs: root.screen == 1 || root.screen == 3 || root.screen == 4 || root.screen == 5;
    property <int> tab-index: root.screen == 1 ? 0 : root.screen == 3 ? 1 : root.screen == 4 ? 2 : 3;
    // The scrolling forms are fixed-height columns inside a Flickable: grow them for the parts that come and go.
    property <length> form-height: 700px + (root.otp-code != "" ? 140px : 0px) + (root.otp-invalid ? 46px : 0px) + (root.error != "" ? 64px : 0px);
    property <length> auth-height: 560px + (root.a-code != "" ? 140px : 0px) + (root.a-invalid ? 46px : 0px) + (root.error != "" ? 64px : 0px);
    property <length> gen-height: 868px + gen-banner.wanted;
    property <length> more-height: 662px + (root.export-ask != 0 ? 200px : 0px) + (root.bio-available ? 106px : 0px) + more-banner.wanted + 170px + (root.cloud-linked ? 66px : 0px) + (root.cloud-choice ? 292px : 0px);
    property <length> cloud-height: 560px + (root.error != "" ? 64px : 0px);

    // A fresh generated password flashes in.
    property <bool> preview-dim: false;
    changed gen-preview => { root.preview-dim = true; }
    Timer {
        interval: 80ms;
        running: root.preview-dim;
        triggered => { root.preview-dim = false; }
    }

    VerticalLayout {
        width: root.width;
        height: root.height;
        spacing: 0px;

        // Every screen lives here; only the active one is visible.
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // 0: Unlock or create
            SilkScreen {
                active: root.screen == 0;
                width: parent.width;
                height: parent.height;
                Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: max(root.height, 780px);
                    VerticalLayout {
                        width: root.width;
                        height: max(root.height, 780px);
                        alignment: start;
                        padding: 24px;
                        padding-top: 32px + root.safe-area-insets.top;
                        spacing: 14px;
                        Rectangle {
                            height: 124px;
                            property <float> breathe: root.busy ? Math.sin(animation-tick() / 1s * 4.0 * 1rad) : 0.0;
                            Rectangle {
                                width: 112px + 10px * parent.breathe;
                                height: self.width;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: self.width / 2;
                                background: Theme.accent-soft;
                                opacity: 0.6 + 0.3 * parent.breathe;
                            }
                            // The official Silk icon (assets/silk-icon.png, resized to 256 px).
                            Image {
                                width: 80px;
                                height: 80px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("silk-icon.png");
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: root.creating ? "Create your vault" : "Unlock vault";
                            font-size: 30px;
                            font-weight: 600;
                            color: Theme.fg;
                            horizontal-alignment: center;
                        }
                        if !root.creating : Text {
                            text: "Your logins are encrypted on this device.";
                            wrap: word-wrap;
                            font-size: 14px;
                            color: Theme.muted;
                            horizontal-alignment: center;
                        }
                        if root.creating : Text {
                            text: "You'll need your master password, and your key file if you use one, to open this vault. Nobody can recover them for you, so keep a copy of the key file somewhere safe.";
                            wrap: word-wrap;
                            font-size: 14px;
                            color: Theme.muted;
                        }
                        SilkField { label: "Master password"; secret: true; text <=> root.pw1; edited => { root.activity(); } }
                        if root.creating : SilkField { label: "Confirm master password"; secret: true; text <=> root.pw2; edited => { root.activity(); } }
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: root.key-file-name == "" ? "No key file" : root.key-file-name;
                                color: Theme.fg;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            SilkLink { text: "Choose key file"; clicked => { root.pick-key-file(); } }
                            if root.key-file-name != "" : SilkLink { text: "Clear"; clicked => { root.clear-key-file(); } }
                        }
                        if root.creating : SilkLink { text: "Create a new key file"; clicked => { root.create-key-file(); } }
                        if root.creating : SilkLink { text: "Restore from backup"; clicked => { root.restore-backup(); } }
                        SilkBanner { error: root.error; notice: root.notice; }
                        SilkButton {
                            text: root.creating ? "Create vault" : "Unlock vault";
                            primary: true;
                            busy: root.busy;
                            active: !root.busy && root.pw1 != "";
                            clicked => { root.submit(); }
                        }
                        if root.bio-enrolled && !root.creating : SilkButton {
                            text: "Unlock with biometrics";
                            active: !root.busy;
                            clicked => { root.bio-unlock(); }
                        }
                    }
                }
            }

            // 1: Logins
            SilkScreen {
                active: root.screen == 1;
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 22px + root.safe-area-insets.top;
                    spacing: 10px;
                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 2px;
                        Text { text: "Logins"; font-size: 30px; font-weight: 600; color: Theme.fg; }
                        Text { text: root.rows.length == 1 ? "1 login" : "\{root.rows.length} logins"; font-size: 14px; color: Theme.muted; }
                    }
                    if !root.autofill-on : VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Rectangle {
                            height: 68px;
                            background: Theme.accent-soft;
                            border-radius: Theme.r-card;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 6px;
                                spacing: 4px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: "Autofill is off"; font-size: 15px; font-weight: 500; color: Theme.fg; overflow: elide; }
                                    Text { text: "Turn it on to fill logins in other apps."; font-size: 12px; color: Theme.muted; overflow: elide; }
                                }
                                VerticalLayout { alignment: center; SilkLink { text: "Turn on"; clicked => { root.enable-autofill(); } } }
                            }
                        }
                    }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        SilkField { icon: 5; label: "Search logins"; text <=> root.query; edited => { root.activity(); root.search(); } }
                    }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        SilkBanner { error: root.error; notice: root.notice; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: root.rows.length * 76px + 96px;
                            VerticalLayout {
                                width: root.width;
                                height: root.rows.length * 76px;
                                alignment: start;
                                for r in root.rows : RowItem {
                                    title: r.title;
                                    subtitle: r.subtitle;
                                    clicked => { root.open-login(r.id); }
                                }
                            }
                        }
                        if root.rows.length == 0 : SilkEmpty {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: min(parent.height, 380px);
                            icon: 0;
                            title: root.query == "" ? "No logins yet" : "No matches";
                            text: root.query == "" ? "Add your first login, or import from Proton Pass under More." : "No logins match your search.";
                        }
                        Rectangle {
                            width: 152px;
                            height: 56px;
                            x: parent.width - self.width - 18px;
                            y: parent.height - self.height - 18px;
                            border-radius: Theme.r-card;
                            background: Theme.accent;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #00000026;
                            drop-shadow-offset-y: 3px;
                            Rectangle {
                                border-radius: Theme.r-card;
                                background: Theme.on-accent;
                                opacity: fab-touch.pressed ? 0.16 : 0.0;
                                animate opacity { duration: 140ms; }
                            }
                            SilkIcon { x: 20px; y: 16px; kind: 4; tint: Theme.on-accent; thickness: 2.4px; }
                            Text {
                                x: 52px;
                                y: 0px;
                                width: parent.width - 64px;
                                height: parent.height;
                                text: "Add login";
                                font-size: 16px;
                                font-weight: 500;
                                color: Theme.on-accent;
                                vertical-alignment: center;
                            }
                            fab-touch := TouchArea { clicked => { root.new-login(); } }
                        }
                    }
                }
            }

            // 2: Edit login
            SilkScreen {
                active: root.screen == 2;
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 12px + root.safe-area-insets.top;
                    spacing: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        SilkLink { text: "Back"; clicked => { root.back(); } }
                        Text { text: root.is-new ? "New login" : "Edit login"; font-size: 20px; font-weight: 600; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
                        if !root.is-new : SilkLink { text: "Delete"; tint: Theme.danger; clicked => { root.delete-login(); } }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.form-height;
                        VerticalLayout {
                            width: root.width;
                            height: root.form-height;
                            alignment: start;
                            padding: 16px;
                            spacing: 10px;
                            SilkField { label: "Title"; text <=> root.f-title; edited => { root.activity(); } }
                            SilkField { label: "Username or email"; text <=> root.f-user; edited => { root.activity(); } }
                            SilkField { label: "Password"; secret: !root.show-password; text <=> root.f-password; edited => { root.activity(); } }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: start;
                                SilkLink { text: root.show-password ? "Hide" : "Show"; clicked => { root.show-password = !root.show-password; } }
                                SilkLink { text: "Generate"; clicked => { if (!root.is-new && root.f-password != "") { root.confirm-gen = true; } else { root.generate(); } } }
                                SilkLink { text: "Copy"; clicked => { root.copy-password(); } }
                            }
                            SilkField { label: "Website or app"; text <=> root.f-url; edited => { root.activity(); } }
                            Text {
                                text: "https://example.com or androidapp://com.example.app. Autofill uses this to find the login.";
                                wrap: word-wrap;
                                font-size: 12px;
                                color: Theme.muted;
                            }
                            SilkField { label: "One-time password secret"; text <=> root.f-otp; edited => { root.activity(); root.otp-edited(); } }
                            if root.otp-code != "" : OtpCard {
                                code: root.otp-code;
                                left-text: root.otp-left-text;
                                progress: root.otp-progress;
                                copy => { root.copy-otp(); }
                            }
                            if root.otp-invalid : Text {
                                text: "That isn't a valid secret. Paste the Base32 setup key or an otpauth:// link.";
                                wrap: word-wrap;
                                font-size: 13px;
                                color: Theme.danger;
                            }
                            SilkField { label: "Notes"; multiline: true; text <=> root.f-notes; edited => { root.activity(); } }
                            SilkBanner { error: root.error; notice: ""; }
                            SilkButton { text: "Save login"; primary: true; active: root.f-title != ""; clicked => { root.save(); } }
                        }
                    }
                }
            }

            // 3: Codes, every login's one-time password in one list
            SilkScreen {
                active: root.screen == 3;
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 22px + root.safe-area-insets.top;
                    spacing: 10px;
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 16px;
                        spacing: 4px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Codes"; font-size: 30px; font-weight: 600; color: Theme.fg; }
                            Text { text: root.otp-rows.length == 1 ? "1 authenticator" : "\{root.otp-rows.length} authenticators"; font-size: 14px; color: Theme.muted; }
                        }
                        VerticalLayout { alignment: center; SilkPill { text: "Add"; icon: 4; clicked => { root.new-authenticator(); } } }
                    }
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        SilkBanner { error: root.error; notice: root.notice; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: root.otp-rows.length * 132px + 24px;
                            VerticalLayout {
                                width: root.width;
                                height: root.otp-rows.length * 132px;
                                alignment: start;
                                for r in root.otp-rows : CodeRow {
                                    title: r.title;
                                    subtitle: r.subtitle;
                                    code: r.code;
                                    left-text: r.left-text;
                                    progress: r.progress;
                                    copy => { root.copy-code(r.id); }
                                    edit => { root.open-login(r.id); }
                                }
                            }
                        }
                        if root.otp-rows.length == 0 : SilkEmpty {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: min(parent.height, 380px);
                            icon: 1;
                            title: "No codes yet";
                            text: "Tap Add to set up an authenticator, or add a one-time password secret to any login.";
                        }
                    }
                }
            }

            // 4: Generator
            SilkScreen {
                active: root.screen == 4;
                width: parent.width;
                height: parent.height;
                Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: root.gen-height + root.safe-area-insets.top;
                    VerticalLayout {
                        width: root.width;
                        height: root.gen-height + root.safe-area-insets.top;
                        alignment: start;
                        padding: 18px;
                        padding-top: 22px + root.safe-area-insets.top;
                        spacing: 12px;
                        VerticalLayout {
                            padding-left: 2px;
                            spacing: 2px;
                            Text { text: "Generator"; font-size: 30px; font-weight: 600; color: Theme.fg; }
                            Text { text: "Strong, random passwords"; font-size: 14px; color: Theme.muted; }
                        }
                        Rectangle {
                            height: 152px;
                            border-radius: Theme.r-card;
                            background: Theme.accent-soft;
                            TouchArea { clicked => { root.gen-copy(); } }
                            Text { x: 18px; y: 14px; text: "GENERATED PASSWORD"; font-size: 12px; font-weight: 500; color: Theme.muted; }
                            Text {
                                x: 18px;
                                y: 38px;
                                width: parent.width - 36px;
                                height: 84px;
                                text: root.gen-preview;
                                font-size: 22px;
                                font-family: "monospace";
                                color: Theme.accent;
                                wrap: word-wrap;
                                opacity: root.preview-dim ? 0.15 : 1.0;
                                animate opacity { duration: root.preview-dim ? 0ms : 300ms; easing: ease-out; }
                            }
                            Text { x: 18px; y: 126px; width: parent.width - 36px; text: root.gen-strength; font-size: 12px; color: Theme.muted; overflow: elide; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            SilkButton { text: "New password"; primary: true; clicked => { root.gen-regenerate(); } }
                            SilkButton { text: "Copy"; clicked => { root.gen-copy(); } }
                        }
                        gen-banner := SilkBanner { error: root.error; notice: root.notice; }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            Text { text: "Length"; font-size: 16px; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: "\{root.gen-length}"; font-size: 18px; font-weight: 600; color: Theme.accent; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            SilkIconButton {
                                icon: 8;
                                clicked => {
                                    if (root.gen-length > 8) {
                                        root.gen-length -= 1;
                                        root.gen-changed();
                                    }
                                }
                            }
                            SilkSlider {
                                horizontal-stretch: 1;
                                minimum: 8;
                                maximum: 64;
                                value <=> root.gen-length;
                                changed => { root.gen-changed(); }
                            }
                            SilkIconButton {
                                icon: 4;
                                clicked => {
                                    if (root.gen-length < 64) {
                                        root.gen-length += 1;
                                        root.gen-changed();
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 432px;
                            border-radius: Theme.r-card;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.outline;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 0px;
                                SilkToggle { label: "Lowercase"; hint: "a to z"; checked <=> root.gen-lower; toggled => { root.gen-changed(); } }
                                Rectangle { height: 1px; background: Theme.divider; }
                                SilkToggle { label: "Uppercase"; hint: "A to Z"; checked <=> root.gen-upper; toggled => { root.gen-changed(); } }
                                Rectangle { height: 1px; background: Theme.divider; }
                                SilkToggle { label: "Numbers"; hint: "0 to 9"; checked <=> root.gen-digits; toggled => { root.gen-changed(); } }
                                Rectangle { height: 1px; background: Theme.divider; }
                                SilkToggle { label: "Symbols"; hint: "! @ # $ % ^ & * - _ = + ?"; checked <=> root.gen-symbols; toggled => { root.gen-changed(); } }
                                Rectangle { height: 1px; background: Theme.divider; }
                                SilkToggle { label: "Avoid look-alikes"; hint: "Leaves out l I 1 O 0 o"; checked <=> root.gen-lookalikes; toggled => { root.gen-changed(); } }
                                Rectangle { height: 1px; background: Theme.divider; }
                                SilkToggle { label: "Fill new logins automatically"; hint: "Start every new login with a generated password"; checked <=> root.auto-generate; toggled => { root.gen-changed(); } }
                            }
                        }
                    }
                }
            }

            // 5: More
            SilkScreen {
                active: root.screen == 5;
                width: parent.width;
                height: parent.height;
                Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: root.more-height + root.safe-area-insets.top;
                    VerticalLayout {
                        width: root.width;
                        height: root.more-height + root.safe-area-insets.top;
                        alignment: start;
                        padding: 18px;
                        padding-top: 22px + root.safe-area-insets.top;
                        spacing: 12px;
                        Text { text: "More"; font-size: 30px; font-weight: 600; color: Theme.fg; height: 40px; }
                        more-banner := SilkBanner { error: root.error; notice: root.notice; }

                        SectionLabel { text: "AUTOFILL"; }
                        Rectangle {
                            height: 60px;
                            border-radius: Theme.r-card;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.outline;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 6px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: root.autofill-on ? Theme.accent : Theme.danger;
                                        animate background { duration: 240ms; }
                                    }
                                }
                                Text {
                                    text: root.autofill-on ? "Autofill is on" : "Autofill is off";
                                    font-size: 15px;
                                    color: Theme.fg;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if !root.autofill-on : VerticalLayout { alignment: center; SilkLink { text: "Turn on"; clicked => { root.enable-autofill(); } } }
                            }
                        }

                        SectionLabel { text: "CLOUD SYNC"; }
                        Text {
                            text: root.cloud-status;
                            wrap: word-wrap;
                            font-size: 14px;
                            color: Theme.muted;
                        }
                        if root.cloud-configured && !root.cloud-linked : SilkButton { text: "Sign in or create account"; primary: true; clicked => { root.go(7); } }
                        if root.cloud-linked : SilkButton {
                            text: "Sync now";
                            primary: true;
                            busy: root.cloud-busy;
                            active: !root.cloud-busy;
                            clicked => { root.cloud-sync(); }
                        }
                        if root.cloud-linked : SilkButton { text: "Sign out"; clicked => { root.cloud-sign-out(); } }
                        if root.cloud-choice : Rectangle {
                            height: 280px;
                            border-radius: Theme.r-card;
                            background: Theme.danger-soft;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text {
                                    text: "This device and your cloud account hold different vaults. Nothing has been changed. Choose the one to keep; the other one is replaced.";
                                    wrap: word-wrap;
                                    font-size: 14px;
                                    color: Theme.fg;
                                }
                                SilkButton { text: "Keep this device's vault"; clicked => { root.cloud-choose(true); } }
                                SilkButton { text: "Use the cloud vault"; clicked => { root.cloud-choose(false); } }
                            }
                        }

                        SectionLabel { text: "PROTON PASS"; }
                        Text {
                            text: "Import an unencrypted Proton Pass export (JSON or CSV). Logins already in this vault are skipped.";
                            wrap: word-wrap;
                            font-size: 14px;
                            color: Theme.muted;
                        }
                        SilkButton { text: "Import from Proton Pass"; primary: true; clicked => { root.import-proton(); } }
                        SilkButton { text: "Export for Proton Pass (CSV)"; clicked => { root.export-ask = 1; } }
                        SilkButton { text: "Export for Proton Pass (JSON)"; clicked => { root.export-ask = 2; } }
                        Rectangle {
                            height: root.export-ask != 0 ? 200px : 0px;
                            clip: true;
                            border-radius: Theme.r-card;
                            background: Theme.danger-soft;
                            opacity: root.export-ask != 0 ? 1.0 : 0.0;
                            animate height { duration: 260ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                            animate opacity { duration: 200ms; easing: ease-out; }
                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;
                                Text {
                                    text: "This file is NOT encrypted. Anyone who gets it can read every password in it. Save it somewhere private and delete it once Proton Pass has imported it.";
                                    wrap: word-wrap;
                                    font-size: 14px;
                                    color: Theme.fg;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    SilkButton { text: "Cancel"; clicked => { root.export-ask = 0; } }
                                    SilkButton {
                                        text: "Export anyway";
                                        primary: true;
                                        clicked => {
                                            root.export-file(root.export-ask);
                                            root.export-ask = 0;
                                        }
                                    }
                                }
                            }
                        }

                        if root.bio-available : SectionLabel { text: "SECURITY"; }
                        if root.bio-available : Rectangle {
                            height: 68px;
                            border-radius: Theme.r-card;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.outline;
                            SilkToggle {
                                x: 4px;
                                y: 0px;
                                width: parent.width - 8px;
                                label: "Unlock with biometrics";
                                hint: "Fingerprint or face instead of the master password";
                                checked <=> root.bio-enrolled;
                                toggled => { root.bio-set(root.bio-enrolled); }
                            }
                        }

                        SectionLabel { text: "VAULT"; }
                        SilkButton { text: "Back up vault (encrypted)"; clicked => { root.backup(); } }
                        SilkButton { text: "Lock now"; clicked => { root.lock(); } }
                        Text { text: root.app-version == "" ? "" : "Silk \{root.app-version}"; font-size: 12px; color: Theme.muted; horizontal-alignment: center; }
                    }
                }
            }

            // 6: Add authenticator
            SilkScreen {
                active: root.screen == 6;
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 12px + root.safe-area-insets.top;
                    spacing: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        SilkLink { text: "Back"; clicked => { root.back-codes(); } }
                        Text { text: "Add authenticator"; font-size: 20px; font-weight: 600; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.auth-height;
                        VerticalLayout {
                            width: root.width;
                            height: root.auth-height;
                            alignment: start;
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "Paste the setup key or the otpauth:// link a website shows when you turn on two-factor authentication.";
                                wrap: word-wrap;
                                font-size: 14px;
                                color: Theme.muted;
                            }
                            SilkField { label: "Name (for example GitHub)"; text <=> root.a-name; edited => { root.activity(); } }
                            SilkField { label: "Setup key or otpauth:// link"; text <=> root.a-secret; edited => { root.activity(); root.auth-edited(); } }
                            if root.a-invalid : Text {
                                text: "That isn't a valid secret. Paste the Base32 setup key or an otpauth:// link.";
                                wrap: word-wrap;
                                font-size: 13px;
                                color: Theme.danger;
                            }
                            if root.a-code != "" : OtpCard {
                                code: root.a-code;
                                left-text: root.a-left-text;
                                progress: root.a-progress;
                                copyable: false;
                            }
                            SilkBanner { error: root.error; notice: ""; }
                            SilkButton {
                                text: "Save authenticator";
                                primary: true;
                                active: root.a-name != "" && root.a-code != "";
                                clicked => { root.save-authenticator(); }
                            }
                        }
                    }
                }
            }

            // 7: Cloud account (sign in or create account)
            SilkScreen {
                active: root.screen == 7;
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-top: 12px + root.safe-area-insets.top;
                    spacing: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        SilkLink { text: "Back"; clicked => { root.go(5); } }
                        Text { text: "Cloud account"; font-size: 20px; font-weight: 600; color: Theme.fg; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.cloud-height;
                        VerticalLayout {
                            width: root.width;
                            height: root.cloud-height;
                            alignment: start;
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: "Your vault is stored in the cloud already encrypted: Supabase (sign-in and storage) never sees your master password or your logins. This account only decides who may download the encrypted files, so give it a password of its own. Silk saves the sign-in (never this password) in your key file.";
                                wrap: word-wrap;
                                font-size: 14px;
                                color: Theme.muted;
                            }
                            SilkField { label: "Account email"; text <=> root.cloud-email; edited => { root.activity(); } }
                            SilkField { label: "Account password"; secret: true; text <=> root.cloud-pw; edited => { root.activity(); } }
                            SilkBanner { error: root.error; notice: ""; }
                            SilkButton {
                                text: "Sign in";
                                primary: true;
                                busy: root.cloud-busy;
                                active: !root.cloud-busy && root.cloud-email != "" && root.cloud-pw != "";
                                clicked => { root.cloud-sign-in(); }
                            }
                            SilkButton {
                                text: "Create account";
                                active: !root.cloud-busy && root.cloud-email != "" && root.cloud-pw != "";
                                clicked => { root.cloud-sign-up(); }
                            }
                        }
                    }
                }
            }
        }

        TabBar {
            shown: root.show-tabs;
            current: root.tab-index;
            bottom-inset: root.safe-area-insets.bottom;
            pick(i) => { root.go(i == 0 ? 1 : i == 1 ? 3 : i == 2 ? 4 : 5); }
        }
    }

    // Confirm before replacing the password of an existing login
    Rectangle {
        property <bool> open: root.confirm-gen && root.screen == 2;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        opacity: self.open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; easing: ease-out; }
        TouchArea { clicked => { root.confirm-gen = false; } }
        Rectangle {
            width: min(root.width - 48px, 360px);
            height: 290px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (parent.open ? 0px : 30px);
            animate y { duration: 320ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
            border-radius: Theme.r-card;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.outline;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0000002e;
            drop-shadow-offset-y: 6px;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "Replace this password?"; font-size: 19px; font-weight: 600; color: Theme.fg; wrap: word-wrap; }
                Text {
                    text: "This login already has a password. Generating a new one replaces the one shown here. If you save, the old one is gone.";
                    wrap: word-wrap;
                    font-size: 14px;
                    color: Theme.muted;
                }
                SilkButton { text: "Replace password"; primary: true; clicked => { root.confirm-gen = false; root.generate(); } }
                SilkLink { text: "Cancel"; clicked => { root.confirm-gen = false; } }
            }
        }
    }

    // Invisible: takes keyboard focus whenever the screen changes, so a hidden field can't keep the keyboard open.
    focus-sink := FocusScope {
        width: 0px;
        height: 0px;
    }
}
