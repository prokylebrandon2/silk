rules_version = '2';
// Retired. Silk used to keep the two encrypted vault files in Firebase Storage; they now live in
// Supabase Storage (see supabase/storage-policies.sql) and Firebase is used for sign-in only.
// Deploying these rules closes the old Firebase bucket completely, which is what you want once
// nothing in it is needed any more: firebase deploy --only storage
// If an old vault is still in that bucket, download it from the Firebase console first.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
