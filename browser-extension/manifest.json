{
  "manifest_version": 3,
  "name": "Silk",
  "version": "1.0.0",
  "minimum_chrome_version": "127",
  "description": "Your Silk vault in the browser: sign in once, then it opens instantly and fills logins and one-time codes. Add, edit, generate and sync like the app.",
  "action": {
    "default_title": "Silk",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["src/autofill.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open Silk"
    },
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Fill the login for this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'; connect-src 'self' https://*.supabase.co"
  }
}
